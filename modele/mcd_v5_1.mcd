/\ CONTRAT <- CONTRAT_REPRIS
/XT\ DOCUMENT_FINANCIER <- RECU, QUITTANCE
AVENANT: id_avenant, type_avenant, motif_avenant, date_creation_avenant, date_effet, statut_avenant, nouveau_loyer_avenant, nouvelles_charges_avenant, nouveau_jour_echeance_avenant, date_validation_avenant

RESILIATION: id_resiliation, motif_resiliation, fondement_contractuel, date_demande_resiliation, date_notification_resiliation, date_limite_regularisation, date_effet_confirmee, date_decision_resiliation, statut_resiliation, reference_justificatif, commentaire_resiliation
INITIER, 0N UTILISATEUR, 11 PROLONGATION
UTILISER, 0N UTILISATEUR, 01 INVITATION
INVITATION: id_invitation, email_invite, jeton_hash, date_envoi_invitation, date_expiration, date_utilisation, date_annulation
CONCERNER, 0N CONTRAT, 11 INVITATION
CONTRAT: id_contrat, reference_contrat, motif_creation, date_creation_contrat, date_activation, date_debut, date_fin_prevue, loyer_mensuel, montant_charges_contrat, jour_echeance, duree_preavis, statut_contrat, date_fin_effective, date_liberation_effective
:
PRECEDER, 01 [ancien] CONTRAT, 01 [nouveau] CONTRAT
AFFECTER, 0N PAIEMENT, 0N ECHEANCE: montant_affecte
CONTRAT_REPRIS: date_reprise, solde_reprise
RECU:
DOCUMENT_FINANCIER: id_document_financier, reference_document, date_generation_document_financier, chemin_fichier_document_financier, statut_document_financier
FORMALISER, 0N AVENANT, 01 DOCUMENT_CONTRAT

:
DECLENCHER, 0N UTILISATEUR, 11 RESILIATION
:
:
